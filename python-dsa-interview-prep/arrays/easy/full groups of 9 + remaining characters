# Approach 5: Your Exact Version
# Correct Logic
# Repeated string concatenation may be less efficient in Python.
def compressed_string_your_version(word):
    read = 0
    comp = ""

    while read < len(word):

        current_char = word[read]
        count = 0

        while read < len(word) and word[read] == current_char:
            count += 1
            read += 1

        if count >= 9:
            quo = count // 9
            remain = count % 9

            if remain == 0:
                comp += f"9{current_char}" * quo
            else:
                comp += (
                    f"9{current_char}" * quo
                    + f"{remain}{current_char}"
                )

        else:
            comp += f"{count}{current_char}"

    return comp
