# Approach 3: Read Pointer + Maximum Chunk of 9
# Instead of counting the whole group first,
# directly process chunks of maximum size 9.
# Time Complexity: O(n)
# Space Complexity: O(n) for output
def compressed_string_chunk_pointer(word):
    read = 0
    result = []

    while read < len(word):

        start = read
        current_char = word[read]

        # Read at most 9 same characters
        while (
            read < len(word)
            and word[read] == current_char
            and read - start < 9
        ):
            read += 1

        count = read - start

        result.append(f"{count}{current_char}")

    return "".join(result)


