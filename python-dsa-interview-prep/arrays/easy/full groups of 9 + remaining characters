# Approach 1: Nested While + Quotient / Remainder
# Your Approach
# Recommended Group-Counting Approach
# Time Complexity: O(n)
# Space Complexity: O(n) for output
def compressed_string_group_count(word):
    read = 0
    result = []

    while read < len(word):

        current_char = word[read]
        count = 0

        # Count complete consecutive group
        while read < len(word) and word[read] == current_char:
            count += 1
            read += 1

        quotient = count // 9
        remainder = count % 9

        # Add all full groups of 9
        for _ in range(quotient):
            result.append(f"9{current_char}")

        # Add remaining group
        if remainder > 0:
            result.append(f"{remainder}{current_char}")

    return "".join(result)


