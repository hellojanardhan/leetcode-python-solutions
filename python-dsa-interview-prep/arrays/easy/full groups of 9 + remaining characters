# Approach 2: Single Pass + Running Count
# Flush when:
# 1. character changes
# 2. count reaches 9
# Recommended / Very Clean Approach
# Time Complexity: O(n)
# Space Complexity: O(n) for output
def compressed_string_running_count(word):
    result = []

    current_char = word[0]
    count = 0

    for char in word:

        # Close current chunk if character changes
        # or current chunk already has 9 chars
        if char != current_char or count == 9:
            result.append(f"{count}{current_char}")

            current_char = char
            count = 0

        count += 1

    # Final chunk
    result.append(f"{count}{current_char}")

    return "".join(result)


