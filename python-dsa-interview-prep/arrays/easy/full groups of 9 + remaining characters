# Approach 4: itertools.groupby + Chunk Splitting
# Pythonic Approach
# Time Complexity: O(n)
# Space Complexity: O(n) for output
def compressed_string_groupby(word):
    from itertools import groupby

    result = []

    for char, group in groupby(word):

        count = sum(1 for _ in group)

        while count > 9:
            result.append(f"9{char}")
            count -= 9

        if count > 0:
            result.append(f"{count}{char}")

    return "".join(result)


